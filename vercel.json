{
  "buildCommand": "npm run build",
  "crons": [
    {
      "path": "/api/cron/scans",
      "schedule": "20 2 * * *"
    },
    {
      "path": "/api/cron/billing",
      "schedule": "20 3 * * *"
    },
    {
      "path": "/api/cron/grace",
      "schedule": "40 3 * * *"
    },
    {
      "path": "/api/cron/cleanup",
      "schedule": "10 4 * * *"
    },
    {
      "path": "/api/cron/reputation",
      "schedule": "50 4 * * 1"
    },
    {
      "path": "/api/cron/summary",
      "schedule": "30 5 * * 1"
    },
    {
      "path": "/api/cron/backups",
      "schedule": "10 5 * * *"
    }
  ]
}
