# Copy to .env.local and fill in. Never commit .env.local.
# In production these live only in the host's environment settings.
#
# Variables marked [neon] are written by `neon deploy` / `neon env pull`.
# Do not hand-edit those -- re-pull instead.

# --- Database [neon] ------------------------------------------------------
# Pooled (PgBouncer) connection, for application queries.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct connection. REQUIRED for migrations, pg_dump and anything using
# session state -- those fail over a pooled connection in ways that never
# mention pooling.
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# Which Neon branch these credentials belong to. Reported by /health.
NEON_BRANCH=production

# --- Redirect host --------------------------------------------------------
# Baked into every printed QR code. Once a code is printed this can NEVER
# change, so it is set deliberately per environment.
#   local:      http://localhost:3100
#   demo:       https://dplus-qr.vercel.app
#   production: https://qriateplus.com
# Never print or distribute a code generated against a demo base URL.
QR_BASE_URL=http://localhost:3000

# --- Neon Auth (Managed Better Auth) -------------------------------------
# [neon] Branch Auth URL, including its path.
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.region.aws.neon.tech/neondb/auth
# [neon] JWKS endpoint, for verifying tokens in Neon Functions.
NEON_AUTH_JWKS_URL=
# OURS to generate, not injected by Neon. 32+ characters:
#   openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# --- Neon Object Storage (S3-compatible) [neon] --------------------------
# AWS-standard names, so the AWS SDK reads them from the environment.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=https://br-xxx.storage.region.aws.neon.tech
AWS_REGION=us-east-2
# Bucket declared in neon.ts.
QR_BUCKET=assets

# --- Redis (optional) -----------------------------------------------------
# Without these the destination cache falls back to in-process only and the
# redirect rate limiter is disabled. Redirects still work -- but on serverless
# the in-process tier barely survives between invocations, so every scan
# reaches Postgres.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Scan privacy ---------------------------------------------------------
# Mixed with the UTC date into sha256(ip + salt + day). Raw IPs are never
# stored. Minimum 16 characters; generate with `openssl rand -hex 32`.
# Without it, scans are recorded with a null ip_hash (no unique counts).
SCAN_IP_SALT=

# --- Email (Resend) -------------------------------------------------------
# Every outbound message leaves through Resend, by one of two paths:
#
#   1. This app's own mail (admin alerts, abuse reports) -- the Resend API,
#      using the key below.
#   2. Neon Auth's verification, password-reset and OTP mail -- Resend SMTP,
#      configured once on the branch and held by the managed service, NOT set
#      here. Inspect or change it with:
#        neon neon-auth config email-provider get
#        neon neon-auth config email-provider update --type standard \
#          --host smtp.resend.com --port 587 --username resend \
#          --password <RESEND_API_KEY> \
#          --sender-email noreply@mail.qriateplus.com --sender-name 'QRiate+'
#      Login still needs no mailer in this process.
#
# Resend will not send from an unverified domain: verify the EMAIL_FROM domain
# at resend.com/domains first, or every send comes back 403. App mail then
# logs and carries on; auth mail does not arrive at all.
RESEND_API_KEY=
EMAIL_FROM=QRiate+ <noreply@mail.qriateplus.com>

# --- Paystack (Phase 3) ---------------------------------------------------
# Test keys on local and demo, live keys only in production.
PAYSTACK_SECRET_KEY=
