# Copy to .env.local and fill in. Never commit .env.local.
# In production these live only in the host's environment settings.

# --- Database -------------------------------------------------------------
# Neon Postgres connection string for this platform's own project.
# Must include ?sslmode=require.
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require

# --- Redirect host --------------------------------------------------------
# Baked into every printed QR code. Once a code is printed this can NEVER
# change, so it is set deliberately per environment.
#   local:      http://localhost:3000
#   staging:    https://test-qr.de-signplus.com
#   production: https://qr.de-signplus.com
QR_BASE_URL=http://localhost:3000

# --- Redis (optional) -----------------------------------------------------
# Without these the destination cache falls back to in-process only and the
# redirect rate limiter is disabled. Redirects still work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Scan privacy ---------------------------------------------------------
# Mixed with the UTC date into sha256(ip + salt + day). Raw IPs are never
# stored. Minimum 16 characters; generate with `openssl rand -hex 32`.
# Without it, scans are recorded with a null ip_hash (no unique counts).
SCAN_IP_SALT=

# --- Email (Resend) -------------------------------------------------------
# Reuses the De Sign Plus verified sending domain.
RESEND_API_KEY=
EMAIL_FROM=De Sign Plus <noreply@de-signplus.com>

# --- Paystack (Phase 3) ---------------------------------------------------
# Test keys on local and staging, live keys only in production.
PAYSTACK_SECRET_KEY=
